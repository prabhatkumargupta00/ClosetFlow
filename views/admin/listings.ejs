<% layout("/layouts/boilerplate.ejs") -%>

    <div class="mx-auto my-10 max-w-7xl px-4">

        <!-- PAGE HEADER -->
        <div class="mb-8">
            <h2 class="text-2xl font-semibold tracking-tight text-slate-900">
                Manage Listings
            </h2>
            <p class="mt-1 text-sm text-slate-600">
                Centralized control over inventory lifecycle and rental status.
            </p>
        </div>

        <!-- TABLE CARD -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm">

                    <!-- TABLE HEAD -->
                    <thead class="bg-slate-900 text-left text-xs uppercase tracking-wider text-white">
                        <tr>
                            <th class="px-6 py-4 font-medium">Title</th>
                            <th class="px-6 py-4 font-medium">Category</th>
                            <th class="px-6 py-4 font-medium">Occasion</th>
                            <th class="px-6 py-4 font-medium">Price / Day</th>
                            <th class="px-6 py-4 font-medium">Status</th>
                            <th class="px-6 py-4 text-right font-medium w-55">Actions</th>

                        </tr>
                    </thead>

                    <!-- TABLE BODY -->
                    <tbody class="divide-y divide-slate-100">

                        <% listings.forEach(listing=> { %>
                            <tr class="transition hover:bg-slate-50">

                                <!-- TITLE -->
                                <td class="px-6 py-4">
                                    <p class="font-medium text-slate-900">
                                        <%= listing.title %>
                                    </p>
                                    <p class="mt-0.5 text-xs text-slate-500">
                                        <%= listing.location %>
                                    </p>
                                </td>

                                <td class="px-6 py-4 text-slate-700">
                                    <%= listing.category %>
                                </td>

                                <td class="px-6 py-4 text-slate-700">
                                    <%= listing.occasion %>
                                </td>

                                <td class="px-6 py-4 font-medium text-slate-900">
                                    ₹ <%= listing.pricePerDay.toLocaleString("en-IN") %>
                                </td>

                                <!-- STATUS -->
                                <td class="px-6 py-4">
                                    <% if (listing.rentalStatus==="available" ) { %>
                                        <span
                                            class="inline-flex rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">
                                            Available
                                        </span>
                                        <% }  else { %>
                                                <span
                                                    class="inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                                                    Rented
                                                </span>
                                                <% } %>
                                </td>

                                <!-- ACTIONS -->
                                <td class="px-6 py-4">
                                    <div class="flex justify-end">
                                        <form action="/admin/listings/<%= listing._id %>/status" method="POST"
                                            class="flex items-center gap-2">
                                            <select name="status"
                                                class="w-30 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-700 shadow-sm focus:border-slate-900 focus:outline-none">
                                                <option value="available" <%=listing.rentalStatus==="available"
                                                    ? "selected" : "" %>>
                                                    Available
                                                </option>
                                                <option value="rented" <%=listing.rentalStatus==="rented" ? "selected"
                                                    : "" %>>
                                                    Rented
                                                </option>
                                            </select>

                                            <button type="submit"
                                                class="rounded-lg bg-slate-900 px-4 py-1.5 text-sm font-medium text-white shadow transition hover:bg-slate-800">
                                                Update
                                            </button>
                                        </form>
                                    </div>
                                </td>


                            </tr>
                            <% }) %>

                    </tbody>
                </table>
            </div>
        </div>

        <!-- FOOTER ACTION -->
        <div class="mt-6">
            <a href="/admin/dashboard"
                class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100">
                ← Back to Dashboard
            </a>
        </div>

    </div>