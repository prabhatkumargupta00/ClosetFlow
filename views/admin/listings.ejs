<% layout("/layouts/boilerplate.ejs") -%>

<div class="container mt-5 mb-16 px-4 max-w-7xl mx-auto">

    <!-- PAGE HEADER -->
    <div class="bg-linear-to-br! from-indigo-300/60 to-red-300/60 border border-white/20 rounded-2xl p-8 flex flex-col items-center text-center shadow-lg mb-8 text-white">
        <h2 class="text-3xl font-bold tracking-tight m-0">Manage Listings</h2>
        <p class="mt-2 text-white/80 text-sm font-medium tracking-wide">
            Centralized control over inventory lifecycle and rental status.
        </p>
    </div>

    <% if (listings && listings.length > 0) { %>
    <!-- TABLE CARD -->
    <div class="bg-indigo-500/10 backdrop-blur-md rounded-2xl border border-white/20 overflow-hidden shadow-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <!-- TABLE HEAD -->
                <thead class="bg-indigo-500/30 border-b border-white/10">
                    <tr>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Title</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Category</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Occasion</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Price / Day</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest text-center">Status</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest text-center min-w-50">Actions</th>
                    </tr>
                </thead>

                <!-- TABLE BODY -->
                <tbody class="divide-y divide-white/5">
                    <% listings.forEach(listing=> { %>
                        <tr class="hover:bg-white/5 transition-colors duration-200">
                            <!-- TITLE -->
                            <td class="px-6 py-5">
                                <p class="font-bold text-white"><%= listing.title %></p>
                                <p class="mt-0.5 text-[11px] font-medium text-white/50 tracking-wide"><%= listing.location %></p>
                            </td>

                            <td class="px-6 py-5 text-white/90 font-medium">
                                <%= listing.category %>
                            </td>

                            <td class="px-6 py-5 text-white/90 font-medium">
                                <%= listing.occasion %>
                            </td>

                            <td class="px-6 py-5 font-black text-white font-mono">
                                ₹<%= listing.pricePerDay.toLocaleString("en-IN") %>
                            </td>

                            <!-- STATUS -->
                            <td class="px-6 py-5 text-center">
                                <% if (listing.rentalStatus==="available" ) { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-black uppercase tracking-wider bg-emerald-400/20 text-emerald-400 rounded-full border border-emerald-400/30">
                                        <i class="fa-solid fa-check-circle translate-y-0"></i> Available
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-black uppercase tracking-wider bg-red-400/20 text-red-400 rounded-full border border-red-400/30">
                                        <i class="fa-solid fa-circle-xmark translate-y-0"></i> Rented
                                    </span>
                                <% } %>
                            </td>

                            <!-- ACTIONS -->
                            <td class="px-6 py-5">
                                <form action="/admin/listings/<%= listing._id %>/status?_method=PATCH" method="POST" class="flex items-center justify-center gap-2">
                                    <select name="status" class="w-28 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-[11px] font-bold text-white shadow-sm focus:border-indigo-400 focus:outline-none appearance-none cursor-pointer hover:bg-white/20 transition-colors">
                                        <option value="available" <%=listing.rentalStatus==="available" ? "selected" : "" %> class="bg-indigo-900">Available</option>
                                        <option value="rented" <%=listing.rentalStatus==="rented" ? "selected" : "" %> class="bg-indigo-900">Rented</option>
                                    </select>

                                    <button type="submit" class="shrink-0 rounded-full! bg-linear-to-r from-indigo-600 to-indigo-500 px-4 py-1.5 text-[10px] font-black uppercase tracking-widest text-white shadow-lg transition hover:brightness-70 hover:shadow-indigo-500/40 active:scale-95">
                                        Update
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } else { %>
    <!-- Empty State -->
    <div class="mt-8 mb-12 max-w-2xl mx-auto bg-linear-to-br! from-indigo-300/60 to-red-300/60 backdrop-blur-md border border-white/20 rounded-2xl p-10 flex items-center gap-8">
        <div class="shrink-0 w-24 h-24 rounded-2xl bg-white/30 backdrop-blur-md flex items-center justify-center text-white/50">
            <i class="fa-solid fa-tags text-4xl"></i>
        </div>
        <div class="text-left">
            <h3 class="text-lg font-bold text-white mb-1">No listings yet</h3>
            <p class="text-white/70 text-sm mb-4 leading-relaxed"> No outfit listings have been added to the platform. Add your first listing to start accepting rental bookings.</p>
            <a href="/listings/new" class="inline-block px-8 py-3 bg-linear-to-r from-indigo-600 to-indigo-500 text-white text-xs font-black uppercase tracking-widest rounded-full transition shadow-lg shadow-black/20 hover:brightness-75 hover:shadow-indigo-500/40 active:scale-95 no-underline">
                + Add First Listing
            </a>
        </div>
    </div>
    <% } %>

    <!-- FOOTER ACTION -->
    <div class="mt-6 flex justify-center">
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-2.5 text-xs font-black uppercase tracking-widest text-white transition hover:brightness-70 no-underline">
            <i class="fa-solid fa-chevron-left"></i> Back to Dashboard
        </a>
    </div>

</div>