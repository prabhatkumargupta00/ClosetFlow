<% layout("/layouts/boilerplate.ejs") -%>

    <div class="mx-auto mt-10 max-w-7xl px-4">

        <!-- HEADER -->
        <div class="mb-10">
            <h2 class="text-3xl font-semibold tracking-tight text-slate-900">
                Admin Dashboard
            </h2>
            <p class="mt-1 text-sm text-slate-600">
                High-level operational visibility into ClosetFlow inventory and users.
            </p>
        </div>

        <!-- KPI GRID -->
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

            <!-- TOTAL LISTINGS -->
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm uppercase tracking-widest text-slate-500">
                    Total Listings
                </p>
                <p class="mt-3 text-3xl font-semibold text-slate-900">
                    <%= stats.totalListings %>
                </p>
            </div>

            <!-- AVAILABLE -->
            <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6 shadow-sm">
                <p class="text-sm uppercase tracking-widest text-emerald-700">
                    Available
                </p>
                <p class="mt-3 text-3xl font-semibold text-emerald-700">
                    <%= stats.availableListings %>
                </p>
            </div>

            <!-- RENTED -->
            <div class="rounded-2xl border border-red-200 bg-red-50 p-6 shadow-sm">
                <p class="text-sm uppercase tracking-widest text-red-700">
                    Rented
                </p>
                <p class="mt-3 text-3xl font-semibold text-red-700">
                    <%= stats.rentedListings %>
                </p>
            </div>

            <!-- TOTAL USERS -->
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm uppercase tracking-widest text-slate-500">
                    Total Users
                </p>
                <p class="mt-3 text-3xl font-semibold text-slate-900">
                    <%= stats.totalUsers %>
                </p>
            </div>

            <!-- ADMINS -->
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm uppercase tracking-widest text-slate-500">
                    Admins
                </p>
                <p class="mt-3 text-3xl font-semibold text-slate-900">
                    <%= stats.adminCount %>
                </p>
            </div>

        </div>

        <!-- PRIMARY ACTION -->
        <div class="mt-12">
            <a href="/admin/listings"
                class="inline-flex items-center rounded-xl bg-slate-900 px-6 py-3 text-sm font-medium text-white shadow transition hover:bg-slate-800">
                Manage Listings
            </a>
        </div>

    </div>