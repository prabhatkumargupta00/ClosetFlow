<% layout("/layouts/boilerplate.ejs") -%>

    <div class="mx-auto mt-10 max-w-7xl px-4 pb-20">

        <!-- HEADER -->
        <div class="bg-indigo-500/10 backdrop-blur-md border border-white/20 rounded-2xl p-8 flex flex-col items-center text-center shadow-2xl relative overflow-hidden mb-10">
            <div class="relative z-10">
                <h2 class="text-3xl font-black text-white m-0 tracking-tight uppercase">Admin Dashboard</h2>
                <p class="mt-3 text-white/70 text-sm font-medium tracking-wide max-w-lg">
                    Manage all your outfits, users, and rentals in one place.
                </p>
            </div>
        </div>

        <!-- KPI GRID -->
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-12">

            <!-- TOTAL LISTINGS -->
            <div class="group relative bg-indigo-500/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 shadow-2xl transition-all duration-300 hover:border-white/30 hover:scale-[1.02]">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-indigo-500/20 rounded-xl flex items-center justify-center border border-indigo-400/30">
                        <i class="fa-solid fa-layer-group text-indigo-400"></i>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest font-black text-white/50 m-0">Total Listings</p>
                        <p class="text-3xl font-black text-white m-0 leading-none mt-1"><%= stats.totalListings %></p>
                    </div>
                </div>
            </div>

            <!-- AVAILABLE -->
            <div class="group relative bg-indigo-500/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 shadow-2xl transition-all duration-300 hover:border-white/30 hover:scale-[1.02]">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-emerald-400/20 rounded-xl flex items-center justify-center border border-emerald-400/30">
                        <i class="fa-solid fa-check-circle text-emerald-400"></i>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest font-black text-white/50 m-0">Available</p>
                        <p class="text-3xl font-black text-white m-0 leading-none mt-1"><%= stats.availableListings %></p>
                    </div>
                </div>
            </div>

            <!-- RENTED -->
            <div class="group relative bg-indigo-500/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 shadow-2xl transition-all duration-300 hover:border-white/30 hover:scale-[1.02]">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-red-400/20 rounded-xl flex items-center justify-center border border-red-400/30">
                        <i class="fa-solid fa-clock text-red-400"></i>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest font-black text-white/50 m-0">Rented Out</p>
                        <p class="text-3xl font-black text-white m-0 leading-none mt-1"><%= stats.rentedListings %></p>
                    </div>
                </div>
            </div>

            <!-- TOTAL USERS -->
            <div class="group relative bg-indigo-500/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 shadow-2xl transition-all duration-300 hover:border-white/30 hover:scale-[1.02]">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-purple-400/20 rounded-xl flex items-center justify-center border border-purple-400/30">
                        <i class="fa-solid fa-users text-purple-400"></i>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest font-black text-white/50 m-0">Total Users</p>
                        <p class="text-3xl font-black text-white m-0 leading-none mt-1"><%= stats.totalUsers %></p>
                    </div>
                </div>
            </div>

        </div>

        <!-- QUICK ACTIONS SECTION -->
        <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 relative overflow-hidden">
            <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                <div>
                    <h3 class="text-lg font-black text-white uppercase tracking-widest m-0">Inventory Management</h3>
                    <p class="text-white/50 text-sm mt-1 font-medium italic">Manage all your outfits and items here.</p>
                </div>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a href="/admin/listings"
                        class="px-8 py-4 bg-linear-to-r from-indigo-600 to-indigo-500 text-white text-xs font-black uppercase tracking-widest rounded-full transition shadow-lg shadow-black/20 hover:scale-105 hover:shadow-indigo-500/40 active:scale-95 no-underline flex items-center gap-3">
                        <i class="fa-solid fa-list-check"></i> Manage Listings
                    </a>
                    <a href="/admin/rentals"
                        class="px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 text-white text-xs font-black uppercase tracking-widest rounded-full transition hover:bg-white/20 active:scale-95 no-underline flex items-center gap-3">
                        <i class="fa-solid fa-receipt"></i> View All Rentals
                    </a>
                </div>
            </div>
        </div>

    </div>