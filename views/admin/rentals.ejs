<% layout("/layouts/boilerplate.ejs") -%>

<div class="mx-auto my-10 max-w-7xl px-4">

    <!-- PAGE HEADER -->
    <div class="mb-8">
        <h2 class="text-2xl font-semibold tracking-tight text-slate-900">All Rentals</h2>
        <p class="mt-1 text-sm text-slate-600">Platform-wide view of all rental transactions and their status.</p>
    </div>

    <% if (rentals && rentals.length > 0) { %>
    <!-- TABLE CARD -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <!-- HEAD -->
                <thead class="bg-slate-900 text-left text-xs uppercase tracking-wider text-white">
                    <tr>
                        <th class="px-6 py-4 font-medium">Listing</th>
                        <th class="px-6 py-4 font-medium">User</th>
                        <th class="px-6 py-4 font-medium">Period</th>
                        <th class="px-6 py-4 font-medium">Price (₹)</th>
                        <th class="px-6 py-4 font-medium">Status</th>
                        <th class="px-6 py-4 text-right font-medium">Action</th>
                    </tr>
                </thead>
                <!-- BODY -->
                <tbody class="divide-y divide-slate-100">
                    <% rentals.forEach(rental => { %>
                        <tr class="transition hover:bg-slate-50">
                            <td class="px-6 py-4">
                                <p class="font-medium text-slate-900"><%= rental.listing ? rental.listing.title : 'Deleted Listing' %></p>
                            </td>
                            <td class="px-6 py-4 text-slate-700">
                                <p class="font-medium"><%= rental.user.username %></p>
                                <p class="text-xs text-slate-400"><%= rental.user.email %></p>
                            </td>
                            <td class="px-6 py-4 text-slate-700 text-sm">
                                <%= rental.rentalPeriod.start.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %> →
                                <%= rental.rentalPeriod.end.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            </td>
                            <td class="px-6 py-4 font-medium text-slate-900">
                                ₹ <%= rental.price.toLocaleString("en-IN") %>
                            </td>
                            <td class="px-6 py-4">
                                <% if (rental.status === 'completed') { %>
                                    <span class="inline-flex rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">Completed</span>
                                <% } else { %>
                                    <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700"><%= rental.status %></span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <% if (rental.status !== 'completed') { %>
                                    <form action="/admin/rentals/<%= rental._id %>/complete?_method=PUT" method="POST"
                                          onsubmit="return confirm('Mark this rental as completed?')">
                                        <button class="rounded-lg bg-slate-900 px-4 py-1.5 text-sm font-medium text-white shadow transition hover:bg-slate-800">
                                            Mark Completed
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-slate-400 text-sm font-medium">Done</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <% } else { %>
    <!-- Empty State -->
    <div class="mt-6 bg-slate-50 border border-slate-200 rounded-2xl py-20 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white shadow border border-slate-200 mb-5">
            <i class="fa-solid fa-receipt text-2xl text-slate-400"></i>
        </div>
        <h3 class="text-xl font-bold text-slate-800 mb-2">No rentals yet</h3>
        <p class="text-slate-500 text-sm max-w-md mx-auto mb-6">
            No rental transactions have been made on the platform yet. Once users start renting outfits, they'll appear here.
        </p>
        <a href="/listings" class="inline-block px-6 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-lg hover:bg-slate-700 transition no-underline shadow-sm">
            View Listings
        </a>
    </div>
    <% } %>

    <!-- FOOTER ACTION -->
    <div class="mt-6">
        <a href="/admin/dashboard" class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100">
            ← Back to Dashboard
        </a>
    </div>

</div>
