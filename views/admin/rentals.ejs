<% layout("/layouts/boilerplate.ejs") -%>

<div class="container mt-5 mb-16 px-4 max-w-7xl mx-auto">

    <!-- PAGE HEADER -->
    <div class="bg-linear-to-br! from-indigo-300/60 to-red-300/60 border border-white/20 rounded-2xl p-8 flex flex-col items-center text-center shadow-lg mb-8">
        <h3 class="text-3xl font-bold text-white m-0">All Rentals</h3>
        <p class="mt-2 text-white/80 text-sm font-medium tracking-wide">Platform-wide view of all rental transactions and their status.</p>
    </div>

    <% if (rentals && rentals.length > 0) { %>
    <!-- TABLE CARD -->
    <div class="bg-indigo-500/10 backdrop-blur-md rounded-2xl border border-white/20 overflow-hidden shadow-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <!-- HEAD -->
                <thead class="bg-indigo-500/30 border-b border-white/10">
                    <tr>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Listing</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">User</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Period</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Price (₹)</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Status</th>
                        <th class="px-6 py-4 text-center text-xs font-black text-white uppercase tracking-widest">Action</th>
                    </tr>
                </thead>
                <!-- BODY -->
                <tbody class="divide-y divide-white/5">
                    <% rentals.forEach(rental => { %>
                        <tr class="hover:bg-white/5 transition-colors duration-200">
                            <td class="px-6 py-5 whitespace-nowrap">
                                <p class="font-bold text-white"><%= rental.listing ? rental.listing.title : 'Deleted Listing' %></p>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap">
                                <p class="text-sm font-bold text-white"><%= rental.user ? rental.user.username : 'Unknown User' %></p>
                                <p class="text-[11px] font-medium text-white/50 tracking-wide"><%= rental.user ? rental.user.email : 'N/A' %></p>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap text-sm font-semibold text-white/90">
                                <%= rental.rentalPeriod.start.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %> →
                                <%= rental.rentalPeriod.end.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap text-sm font-black text-white font-mono">
                                ₹<%= rental.price.toLocaleString("en-IN") %>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap text-center">
                                <% if (rental.status === 'completed') { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-black uppercase tracking-wider bg-emerald-400/20 text-emerald-400 rounded-full border border-emerald-400/30">
                                        <i class="fa-solid fa-check-circle translate-y-0"></i> Returned
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-black uppercase tracking-wider bg-indigo-400/20 text-indigo-100 rounded-full border border-indigo-400/30">
                                        <i class="fa-solid fa-clock translate-y-0"></i> <%= rental.status %>
                                    </span>
                                <% } %>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap text-center">
                                <% if (rental.status !== 'completed') { %>
                                    <form action="/admin/rentals/<%= rental._id %>/complete?_method=PUT" method="POST"
                                          onsubmit="return confirm('Mark this rental as completed?')">
                                        <button class="px-5 py-2.5 bg-linear-to-r from-indigo-600 to-indigo-500 text-white text-[11px] font-black uppercase tracking-widest rounded-full! transition shadow-lg shadow-black/20 hover:shadow-indigo-500/40 active:scale-95">
                                            Complete Order
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-white/30 font-bold text-xs uppercase tracking-widest">Done</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <% } else { %>
    <!-- Empty State -->
    <div class="mt-8 mb-12 max-w-2xl mx-auto bg-linear-to-br! from-indigo-300/60 to-red-300/60 backdrop-blur-md border border-white/20 rounded-2xl p-10 flex items-center gap-8">
        <div class="shrink-0 w-24 h-24 rounded-2xl bg-white/30 backdrop-blur-md flex items-center justify-center text-white/50">
            <i class="fa-solid fa-receipt text-4xl"></i>
        </div>
        <div class="text-left">
            <h3 class="text-lg font-bold text-white mb-1">No rentals recorded</h3>
            <p class="text-white/70 text-sm mb-4 leading-relaxed">No rental transactions have been made on the platform yet. Once users start renting outfits, they'll appear here.</p>
            <a href="/listings" class="inline-block px-8 py-3 bg-linear-to-r from-indigo-600 to-indigo-500 text-white text-xs font-black uppercase tracking-widest rounded-full transition shadow-lg shadow-black/20 hover:scale-105 hover:shadow-indigo-500/40 active:scale-95 no-underline">
                View Collection →
            </a>
        </div>
    </div>
    <% } %>

    <!-- FOOTER ACTION -->
    <div class="mt-6 flex justify-center">
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-2.5 text-xs font-black uppercase tracking-widest text-white transition hover:bg-white/10 no-underline">
            <i class="fa-solid fa-chevron-left"></i> Back to Dashboard
        </a>
    </div>

</div>
