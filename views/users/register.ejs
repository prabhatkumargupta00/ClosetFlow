<% layout("/layouts/boilerplate") %>

<div class="flex justify-center mt-4">
    <div class="w-full max-w-md lg:max-w-sm">
        <div
            class="rounded-3xl border border-white/20 bg-linear-to-br! from-indigo-300/60 to-red-300/60 backdrop-blur-xl p-6 md:p-8 shadow-2xl overflow-hidden"
        >
            <div class="mx-2 md:mx-4">
                <h2
                    class="text-center font-black text-2xl md:text-3xl mb-8 uppercase tracking-widest text-white"
                >
                    Register
                </h2>

                <form action="/register" method="POST">
                    <!-- Username -->
                    <div class="mb-3">
                        <label class="block font-semibold mb-1">
                            Username
                        </label>
                        <input
                            name="username"
                            placeholder="Enter your username"
                            required
                            class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-gray-400 text-gray-950"
                        />
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="block font-semibold mb-1"> Email </label>
                        <input
                            name="email"
                            type="email"
                            placeholder="Email id"
                            required
                            class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-gray-400 text-gray-950"
                        />
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <label class="block font-semibold mb-1">
                            Password
                        </label>
                        <div class="relative">
                            <input
                                id="password"
                                name="password"
                                type="password"
                                placeholder="••••••••"
                                required
                                class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-gray-400  text-gray-900"
                            />
                            <button
                                type="button"
                                id="togglePassword"
                                class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-700 hover:text-gray-800 focus:outline-none"
                            >
                                <i class="fa-regular fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <script>
                        const togglePassword = document.querySelector('#togglePassword');
                        const password = document.querySelector('#password');
                        const eyeIcon = document.querySelector('#eyeIcon');

                        togglePassword.addEventListener('click', function (e) {
                            // toggle the type attribute
                            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                            password.setAttribute('type', type);
                            
                            // toggle the eye icon
                            eyeIcon.classList.toggle('fa-eye');
                            eyeIcon.classList.toggle('fa-eye-slash');
                        });
                    </script>

                    <!-- Submit -->
                    <div class="grid">
                        <button
                            class="bg-gray-900 text-white text-lg font-medium py-2 px-4 rounded hover:bg-gray-800 transition"
                        >
                            Register
                        </button>
                    </div>
                </form>

                <p class="text-center text-white/70 mt-3 mb-0">
                    Already have an account? &nbsp;
                    <a
                        href="/login"
                        class="no-underline font-semibold text-white"
                    >
                        Login
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
