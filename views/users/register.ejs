<% layout("/layouts/boilerplate") %>

<div class="flex justify-center mt-4">
    <div class="w-full max-w-md lg:max-w-sm">
        <div class="bg-white shadow-sm rounded border border-transparent">
            <div class="p-4">
                <h2 class="text-center font-bold text-2xl mb-4">
                    Create Account
                </h2>

                <form action="/register" method="POST">
                    <!-- Username -->
                    <div class="mb-3">
                        <label class="block font-semibold mb-1">
                            Username
                        </label>
                        <input
                            name="username"
                            placeholder="Enter your username"
                            required
                            class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-gray-400"
                        />
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="block font-semibold mb-1"> Email </label>
                        <input
                            name="email"
                            type="email"
                            placeholder="Email id"
                            required
                            class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-gray-400"
                        />
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <label class="block font-semibold mb-1">
                            Password
                        </label>
                        <input
                            name="password"
                            type="password"
                            placeholder="••••••••"
                            required
                            class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-gray-400"
                        />
                    </div>

                    <!-- Submit -->
                    <div class="grid">
                        <button
                            class="bg-gray-900 text-white text-lg font-medium py-2 px-4 rounded hover:bg-gray-800 transition"
                        >
                            Register
                        </button>
                    </div>
                </form>

                <p class="text-center text-gray-500 mt-3 mb-0">
                    Already have an account?
                    <a
                        href="/login"
                        class="no-underline font-semibold text-gray-900"
                    >
                        Login
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
