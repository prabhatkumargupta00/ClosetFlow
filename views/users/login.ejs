<% layout("/layouts/boilerplate") %>

    <div class="flex justify-center mt-5">
        <div class="w-full max-w-md lg:max-w-sm">

            <div class="bg-white shadow-sm rounded border border-transparent">
                <div class="p-4">

                    <h2 class="text-center font-bold text-2xl mb-4">
                        Welcome Back
                    </h2>

                    <form action="/login" method="POST">

                        <!-- Email -->
                        <div class="mb-3">
                            <label class="block font-semibold mb-1">
                                Email
                            </label>
                            <input name="email" type="email" placeholder="Email id" required class="w-full px-3 py-2 border border-gray-300 rounded
                     focus:outline-none focus:ring-1 focus:ring-gray-400" />
                        </div>

                        <!-- Password -->
                        <div class="mb-4">
                            <label class="block font-semibold mb-1">
                                Password
                            </label>
                            <input name="password" type="password" placeholder="••••••••" required class="w-full px-3 py-2 border border-gray-300 rounded
                     focus:outline-none focus:ring-1 focus:ring-gray-400" />
                        </div>

                        <!-- Submit -->
                        <div class="grid">
                            <button class="bg-gray-900 text-white text-lg font-medium
                            py-2 px-4 rounded
                            hover:bg-gray-800 transition">
                                Login
                            </button>
                        </div>

                    </form>

                    <p class="text-center text-gray-500 mt-3 mb-0">
                        Don’t have an account?
                        <a href="/register" class="font-semibold text-gray-900 no-underline">
                            Register
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>