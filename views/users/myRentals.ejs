<% layout("/layouts/boilerplate.ejs") -%>

<div class="container mt-5 mb-16">
    <div class="bg-linear-to-br! from-indigo-300/60 to-red-300/60 border border-white/20 rounded-2xl p-8 flex flex-col items-center text-center shadow-lg mb-8">
        <h3 class="text-3xl font-bold text-white m-0">My Rentals</h3>
    </div>

    <% if (rentals && rentals.length > 0) { %>
        <div class="bg-indigo-500/10 backdrop-blur-md rounded-2xl border border-white/20 overflow-hidden shadow-2xl">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-indigo-500/30 border-b border-white/10">
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Listing</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Period</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Price (₹)</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Status</th>
                        <th class="px-6 py-4 text-xs font-black text-white uppercase tracking-widest">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    <% rentals.forEach(rental => { %>
                        <tr class="hover:bg-white/5 transition-colors duration-200">
                            <td class="px-6 py-5 whitespace-nowrap">
                                <% if (rental.listing) { %>
                                    <a href="/listings/<%= rental.listing._id %>" class="font-bold text-white hover:text-indigo-200 no-underline transition-colors">
                                        <%= rental.listing.title %>
                                    </a>
                                <% } else { %>
                                    <span class="text-white/40 italic text-sm">Deleted Listing</span>
                                <% } %>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap text-sm font-semibold text-white/90">
                                <% if (rental.rentalPeriod && rental.rentalPeriod.start && rental.rentalPeriod.end) { %>
                                    <%= rental.rentalPeriod.start.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %> - 
                                    <%= rental.rentalPeriod.end.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                <% } else { %>
                                    <span class="text-white/30 italic">Invalid date</span>
                                <% } %>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap text-sm font-black text-white">
                                ₹<%= rental.price.toLocaleString("en-IN") %>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap">
                                <% if (rental.status === 'completed') { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-black uppercase tracking-wider bg-emerald-400/20 text-emerald-400 rounded-full border border-emerald-400/30">
                                        <i class="fa-solid fa-check-circle translate-y-[0.5px]"></i> Returned
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-black uppercase tracking-wider bg-indigo-400/20 text-indigo-100 rounded-full border border-indigo-400/30">
                                        <i class="fa-solid fa-clock translate-y-[0.5px]"></i> <%= rental.status %>
                                    </span>
                                <% } %>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap text-sm">
                                <% if (rental.status !== 'completed') { %>
                                    <form action="/rentals/<%= rental._id %>/complete?_method=PUT" method="POST" 
                                          onsubmit="return confirm('Are you sure you want to mark this rental as returned?')">
                                        <button type="submit" class="px-5 py-2.5 bg-linear-to-r from-indigo-600 to-indigo-500 text-white  font-black uppercase rounded-full! transition shadow-lg shadow-black/20  hover:shadow-indigo-500/40 active:scale-95">
                                            Return Item
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-white/30 font-bold text-xs uppercase tracking-widest">Completed</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

    <% } else { %>
        <!-- Empty State -->
        <div class="mt-8 mb-12 max-w-2xl mx-auto bg-linear-to-br! from-indigo-300/60 to-red-300/60 backdrop-blur-md border border-white/20 rounded-2xl p-10 flex items-center gap-8">
            <div class="shrink-0 w-24 h-24 rounded-2xl bg-white/30 backdrop-blur-md flex items-center justify-center text-white/50">
                <i class="fa-solid fa-shirt text-4xl"></i>
            </div>
            <div class="text-left">
                <h3 class="text-lg font-bold text-white mb-1">Your rental history is empty</h3>
                <p class="text-white/70 text-sm mb-4 leading-relaxed">No outfits rented yet. Browse our collection of premium ethnic wear and book your first outfit today!</p>
                <a href="/listings" class="inline-block px-8 py-3 bg-linear-to-r from-indigo-600 to-indigo-500 text-white text-xs font-black uppercase tracking-widest rounded-full transition shadow-lg shadow-black/20  hover:shadow-indigo-500/40 active:scale-95 no-underline">
                    Browse Collection →
                </a>
            </div>
        </div>
    <% } %>
</div>
