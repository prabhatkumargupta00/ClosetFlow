<% layout("/layouts/boilerplate.ejs") -%>

<div class="container mt-5">
    <h3>My Rentals</h3>
    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Listing</th>
                <th>Period</th>
                <th>Price (₹)</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% rentals.forEach(rental => { %>
                <tr>
                    <td><%= rental.listing.title %></td>
                    <td><%= rental.rentalPeriod.start.toLocaleDateString() %> - <%= rental.rentalPeriod.end.toLocaleDateString() %></td>
                    <td><%= rental.price.toLocaleString("en-IN") %></td>
                    <td>
                        <span class="badge <%= rental.status === 'completed' ? 'bg-success' : 'bg-primary' %>">
                            <%= rental.status %>
                        </span>
                    </td>
                    <td>
                        <% if (rental.status !== 'completed') { %>
                            <form action="/rentals/<%= rental._id %>/complete?_method=PUT" method="POST" 
                                  onsubmit="return confirm('Are you sure you want to mark this rental as completed?')">
                                <button class="btn btn-sm btn-success">Mark as Returned</button>
                            </form>
                        <% } else { %>
                            <span class="text-muted">Completed</span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
