<% layout("/layouts/boilerplate.ejs") -%>


  <!-- LISTINGS GRID -->
  <section id="listings-cloth"
    class="py-12 mb-2 rounded-3xl shadow-xl shadow-indigo-500/5 bg-linear-to-br! from-indigo-300/60 to-red-300/60 backdrop-blur-xl">
    <div class="mx-auto max-w-7xl px-4">
      <!-- SEARCH & FILTER BAR -->
      <div class="mb-10 flex flex-col lg:flex-row items-center justify-between gap-8">
        <h2 class="text-2xl font-bold text-white tracking-tight">Explore the Collection</h2>

        <div class="flex flex-wrap items-center justify-center lg:justify-end gap-x-4 gap-y-3 w-full lg:w-auto">
          <!-- Search Input -->
          <div class="relative w-full sm:w-72">
            <form action="/listings" method="GET" class="relative group">
              <% if (category && category !=='all' ) { %><input type="hidden" name="category" value="<%= category %>">
                <% } %>
                  <% if (sort && sort !=='newest' ) { %><input type="hidden" name="sort" value="<%= sort %>">
                    <% } %>
                      <input type="search" name="q" value="<%= q %>" placeholder="Search outfits..."
                        class="w-full bg-indigo-500/80 backdrop-blur-md border border-white/20 text-white text-sm font-medium rounded-2xl pl-11 pr-4 py-3 outline-none focus:ring-2 focus:ring-indigo-400/50 focus:bg-indigo-500/90 transition-all placeholder:text-white/40 shadow-lg shadow-black/10" />
                      <div
                        class="absolute inset-y-0 left-0 flex items-center pl-4 text-white/50 group-focus-within:text-white/80 transition-colors">
                        <i class="fa-solid fa-magnifying-glass text-xs"></i>
                      </div>
                      <button type="submit" class="hidden">Search</button>
            </form>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
            <!-- Category Filter -->
            <div class="relative">
              <form id="categoryForm" action="/listings" method="GET" class="flex w-full sm:w-auto items-center">
                <% if (q) { %><input type="hidden" name="q" value="<%= q %>">
                  <% } %>
                    <% if (sort) { %><input type="hidden" name="sort" value="<%= sort %>">
                      <% } %>
                        <select name="category" onchange="this.form.submit()"
                          class="w-full sm:w-auto appearance-none bg-indigo-500/80 backdrop-blur-md border border-white/20 text-white text-sm font-bold rounded-2xl px-5 py-3 pr-11 focus:outline-none focus:ring-2 focus:ring-indigo-400/50 transition-all hover:bg-indigo-500/90 cursor-pointer shadow-lg shadow-black/10">
                          <option value="all" <%=category==='all' ? 'selected' : '' %>>All Categories</option>
                          <option value="Lehenga" <%=category==='Lehenga' ? 'selected' : '' %>>Lehenga</option>
                          <option value="Kurta Pajama" <%=category==='Kurta Pajama' ? 'selected' : '' %>>Kurta Pajama
                          </option>
                          <option value="Sherwani" <%=category==='Sherwani' ? 'selected' : '' %>>Sherwani</option>
                          <option value="Anarkali" <%=category==='Anarkali' ? 'selected' : '' %>>Anarkali</option>
                          <option value="Suit" <%=category==='Suit' ? 'selected' : '' %>>Suit</option>
                          <option value="Bandhgala" <%=category==='Bandhgala' ? 'selected' : '' %>>Bandhgala</option>
                        </select>
                        <div
                          class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-white/70">
                          <i class="fa-solid fa-filter text-[10px]"></i>
                        </div>
              </form>
            </div>

            <!-- Sort Dropdown -->
            <div class="relative">
              <form id="sortForm" action="/listings" method="GET" class="flex w-full sm:w-auto items-center">
                <% if (q) { %><input type="hidden" name="q" value="<%= q %>">
                  <% } %>
                    <% if (category) { %><input type="hidden" name="category" value="<%= category %>">
                      <% } %>
                        <select name="sort" onchange="this.form.submit()"
                          class="w-full sm:w-auto appearance-none bg-indigo-500/80 backdrop-blur-md border border-white/20 text-white text-sm font-bold rounded-2xl px-5 py-3 pr-11 focus:outline-none focus:ring-2 focus:ring-indigo-400/50 transition-all hover:bg-indigo-500/90 cursor-pointer shadow-lg shadow-black/10">
                          <option value="newest" <%=sort==='newest' ? 'selected' : '' %>>Newest First</option>
                          <option value="price_low" <%=sort==='price_low' ? 'selected' : '' %>>Price: Low to High
                          </option>
                          <option value="price_high" <%=sort==='price_high' ? 'selected' : '' %>>Price: High to Low
                          </option>
                          <option value="oldest" <%=sort==='oldest' ? 'selected' : '' %>>Oldest First</option>
                        </select>
                        <div
                          class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-white/70">
                          <i class="fa-solid fa-chevron-down text-[10px]"></i>
                        </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <% if (listings && listings.length> 0) { %>
        <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
          <% for(let listing of listings) { %>
            <a href="/listings/<%= listing._id %>" class="group block no-underline focus:outline-none">
              <div
                class="relative overflow-hidden rounded-2xl border border-indigo-100/50 bg-gray-300/90 p-3 shadow-sm ring-1 ring-slate-900/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-500/15 hover:ring-indigo-300 hover:bg-gray-100/90">


                <!-- Image -->
                <div class="relative h-80 w-full overflow-hidden rounded-xl bg-slate-50">
                  <img src="<%= listing.image %>" alt="<%= listing.title %>"
                    class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105" />
                </div>

                <!-- Content -->
                <div class="pt-4 pb-2 px-1 flex justify-between items-start gap-3">
                  <div class="min-w-0 flex-1">
                    <!-- Brand / Category (Green Text) -->
                    <p class="text-[11px] font-bold uppercase tracking-widest text-emerald-500 mb-1">
                      <%= listing.brand || 'PREMIUM' %>
                    </p>

                    <!-- Title -->
                    <h3 class="text-[10px]! font-bold text-slate-900 mb-1 line-clamp-2 leading-tight min-h-10">
                      <%= listing.title %>
                    </h3>

                    <!-- Badges -->
                    <div class="flex flex-wrap gap-2">
                      <% if (listing.size && listing.size.toString().trim() !=="" ) { %>
                        <span
                          class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold uppercase text-slate-700 tracking-wide">
                          <%= Array.isArray(listing.size) ? listing.size.join(', ') : listing.size.split(' ,').join(', ') %>
                      </span>
                    <% } %>
                    <% if (listing.color && listing.color.toString().trim() !== "") { %>
                      <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
                        <%= listing.color %>
                      </span>
                    <% } %>
                  </div>
                </div>

                <!-- Price -->
                <div class="shrink-0 text-right flex flex-col items-end pt-1">
                  <span class="text-xl font-black text-slate-900 leading-none">
                    ₹<%= listing.pricePerDay ? listing.pricePerDay.toLocaleString("en-IN") : ' 0' %>
                        </span>
                        <span class="text-[10px] font-bold uppercase text-slate-400 mt-1.5 tracking-wider">
                          PER DAY
                        </span>
                    </div>

                  </div>
                </div>
            </a>
            <% } %>
        </div>

        <!-- PAGINATION -->
        <!-- PAGINATION CONTAINER -->
        <div
          class="mx-auto mt-16 w-fit rounded-full border  bg-indigo-500/50 p-2 backdrop-blur-md shadow-2xl shadow-indigo-500/10 mb-8">
          <% if (totalPages> 1) { %>
            <div class="flex items-center justify-center gap-3">

              <!-- Previous Arrow -->
              <% if (currentPage> 1) { %>
                <a href="/listings?page=<%= currentPage - 1 %><%= q ? `&q=${q}` : '' %><%= sort ? `&sort=${sort}` : '' %><%= category ? `&category=${category}` : '' %>"
                  class="group flex h-11 w-11 items-center justify-center rounded-full border border-white/40 bg-white/20 backdrop-blur-md text-white transition-all duration-300 hover:scale-110 hover:bg-white/40 hover:border-white/60 no-underline shadow-lg shadow-black/5">
                  <i class="fa-solid fa-chevron-left text-[11px] transition-transform group-hover:-translate-x-0.5"></i>
                </a>
                <% } else { %>
                  <div
                    class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 backdrop-blur-sm text-white/30 cursor-not-allowed">
                    <i class="fa-solid fa-chevron-left text-[11px]"></i>
                  </div>
                  <% } %>

                    <!-- Page Numbers -->
                    <% let startPage=Math.max(1, currentPage - 2); let endPage=Math.min(totalPages, startPage + 4); if
                      (endPage - startPage < 4) startPage=Math.max(1, endPage - 4); %>

                      <% for(let i=startPage; i <=endPage; i++) { %>
                        <% if (i===currentPage) { %>
                          <div
                            class="flex h-11 w-11 items-center justify-center rounded-full bg-linear-to-r from-indigo-600 to-indigo-500 text-sm font-black text-white shadow-xl shadow-indigo-500/40 ring-2 ring-indigo-400/30">
                            <%= i %>
                          </div>
                          <% } else { %>
                            <a href="/listings?page=<%= i %><%= q ? `&q=${q}` : '' %><%= sort ? `&sort=${sort}` : '' %><%= category ? `&category=${category}` : '' %>"
                              class="flex h-11 w-11 items-center justify-center rounded-full border border-white/40 bg-white/20 backdrop-blur-md text-sm font-bold text-white transition-all duration-300 hover:scale-110 hover:bg-white/40 hover:border-white/60 no-underline shadow-lg shadow-black/5">
                              <%= i %>
                            </a>
                            <% } %>
                              <% } %>

                                <!-- Next Arrow -->
                                <% if (currentPage < totalPages) { %>
                                  <a href="/listings?page=<%= currentPage + 1 %><%= q ? `&q=${q}` : '' %><%= sort ? `&sort=${sort}` : '' %><%= category ? `&category=${category}` : '' %>"
                                    class="group flex h-11 w-11 items-center justify-center rounded-full border border-white/40 bg-white/20 backdrop-blur-md text-white transition-all duration-300 hover:scale-110 hover:bg-white/40 hover:border-white/60 no-underline shadow-lg shadow-black/5">
                                    <i
                                      class="fa-solid fa-chevron-right text-[11px] transition-transform group-hover:translate-x-0.5"></i>
                                  </a>
                                  <% } else { %>
                                    <div
                                      class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 backdrop-blur-sm text-white/30 cursor-not-allowed">
                                      <i class="fa-solid fa-chevron-right text-[11px]"></i>
                                    </div>
                                    <% } %>

            </div>
            <% } %>
        </div>



        <% } else { %>
          <!-- Empty State -->
          <div class="py-24 text-center">
            <div
              class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-indigo-50 border border-indigo-100 mb-6">
              <i class="fa-solid fa-vest text-3xl text-indigo-400"></i>
            </div>
            <h3 class="text-2xl font-bold text-slate-800 mb-3">No outfits available yet</h3>
            <p class="text-slate-500 text-sm max-w-md mx-auto mb-8">
              The collection is currently empty. Check back soon — new ethnic wear outfits are being added for your
              special occasions.
            </p>
            <% if (currentUserRole==='admin' ) { %>
              <a href="/listings/new"
                class="inline-block px-6 py-3 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition no-underline shadow-sm">
                + Add First Listing
              </a>
              <% } %>
          </div>
          <% } %>

    </div>
  </section>