<% layout("/layouts/boilerplate.ejs") -%>

    <!-- CARD -->
    <div class="rounded-3xl border border-white/20 bg-linear-to-br! from-indigo-300/60 to-red-300/60 backdrop-blur-xl p-6 md:p-8 shadow-2xl overflow-hidden">

      <!-- IMAGE BLOCK -->
      <div class="mb-10 flex justify-center">
        <div class="relative w-full max-w-md aspect-4/5 overflow-hidden rounded-2xl shadow-2xl ring-1 ring-white/20">
          <img src="<%= listing.image %>" alt="Listing Image" class="h-full w-full object-cover object-top transition duration-500 hover:brightness-75" />

          <span
            class="absolute left-6 top-6 rounded-full bg-slate-700/50  px-5 py-2 text-[10px] font-black uppercase tracking-[0.2em] text-white backdrop-blur-3xl shadow-lg">
            <%= listing.rentalStatus %>
          </span>
        </div>
      </div>

      <!-- DETAILS -->
      <div class="mx-2 md:mx-4">

        <h1 class="text-3xl md:text-4xl font-black leading-none text-white uppercase tracking-tighter mb-4">
          <%= listing.title %>
        </h1>

        <p class="text-lg leading-relaxed text-white/90 font-medium mb-10 border-l-4 border-white/30 pl-6 italic">
          <%= listing.description %>
        </p>

        <!-- META -->
        <div class="grid grid-cols-2 gap-8 mb-10">

          <div class="group">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mb-1 group-hover:text-white/80 transition-colors">Category</p>
            <p class="text-lg font-bold text-white">
              <%= listing.category %>
            </p>
          </div>

          <div class="group">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mb-1 group-hover:text-white/80 transition-colors">Occasion</p>
            <p class="text-lg font-bold text-white">
              <%= listing.occasion %>
            </p>
          </div>

          <div class="group">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mb-1 group-hover:text-white/80 transition-colors">Fit</p>
            <p class="text-lg font-bold text-white">
              <%= listing.fitType %>
            </p>
          </div>

          <div class="group">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mb-1 group-hover:text-white/80 transition-colors">Sizes</p>
            <p class="text-lg font-bold text-white">
              <%= listing.size.join(", ") %></p>
          </div>

          <div class="group">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mb-1 group-hover:text-white/80 transition-colors">Location</p>
            <p class="text-lg font-bold text-white">
              <%= listing.location %>
            </p>
          </div>

          <% if (listing.brand) { %>
            <div class="group">
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mb-1 group-hover:text-white/80 transition-colors">Brand</p>
              <p class="text-lg font-bold text-white text-shadow">
                <%= listing.brand %>
              </p>
            </div>
            <% } %>

          <% if (listing.color) { %>
            <div class="group">
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mb-1 group-hover:text-white/80 transition-colors">Color</p>
              <p class="text-lg font-bold text-white">
                <%= listing.color %>
              </p>
            </div>
          <% } %>

        </div>

        <!-- PRICE + RATING -->
        <div class="flex items-center justify-between border-t border-white/20 pt-8 mb-10">

          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mb-1">Rental Price</p>
            <div class="flex items-baseline gap-1">
              <span class="text-3xl md:text-4xl font-black text-white">₹<%= listing.pricePerDay.toLocaleString("en-IN") %></span>
              <span class="text-xs font-bold text-white/60 uppercase tracking-widest">/ Day</span>
            </div>
          </div>

          <div class="text-right">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mb-1"> Rating</p>
            <div class="flex items-center justify-end gap-2">
              <span class="text-2xl font-black text-amber-400">★ <%= listing.rating %></span>
              <span class="text-xs font-bold text-white/40">/ 5.0</span>
            </div>
          </div>

        </div>

        <!-- CTA -->
        <% if (currentUser) { %>
          <a href="/rentals/<%= listing._id %>"
            class="block w-fit rounded-full! bg-white px-5 py-3 text-sm font-black text-indigo-950 uppercase shadow-2xl transition-all hover:brightness-70 hover:shadow-white/20 text-center no-underline">
            Rent this outfit
          </a>
          <% } else { %>
            <a href="/login"
              class="block w-fit rounded-full! bg-white px-4 py-2 text-sm font-black text-indigo-950 uppercase shadow-2xl transition-all hover:brightness-70 hover:shadow-white/20 text-center no-underline">
              Login to Rent
            </a>
          <% } %>

            <% if (currentUser && (currentUserRole==="admin" || (listing.owner && currentUser.toString() === listing.owner.toString()))) { %>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <!-- Edit --> 
        <a href="/listings/<%= listing._id %>/edit"
          class="inline-flex items-center justify-center w-48 h-12 rounded-full! bg-white text-base font-black uppercase tracking-widest text-indigo-950 transition-all hover:brightness-70 active:scale-95 shadow-xl no-underline whitespace-nowrap">
          Edit Details </a> 
        <!-- Delete -->
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post"
          onsubmit="return confirm('This action cannot be undone. Delete this listing?')"
          class="m-0"> 
          <button type="submit" class="inline-flex items-center justify-center w-48 h-12 rounded-full! bg-white/10 text-base font-black uppercase tracking-widest text-white transition-all hover:brightness-70 active:scale-95 hover:bg-red-500/20 shadow-xl whitespace-nowrap cursor-pointer">
            Remove Listing </button> 
        </form>
      </div>
      <% } %>
      </div>

    </div>

<!-- REVIEWS SECTION -->
<div class="mt-8 rounded-3xl border border-white/20 bg-linear-to-br! from-indigo-800/60 to-red-800/60 backdrop-blur-xl p-6 md:p-8 shadow-2xl">

    <div class="flex items-center mb-10 border-b border-white/20 pb-6">
        <h2 class="text-2xl font-black text-white uppercase tracking-widest">
            Reviews
            <% if (reviews.length > 0) { %>
                <span class="ml-4 text-sm font-black text-amber-400">★ <%= listing.rating %></span>
                <span class="text-xs text-white/40 font-bold ml-2">(<%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %>)</span>
            <% } %>
        </h2>
    </div>

    <!-- REVIEW FORM -->
    <% if (currentUser && hasRented && !hasReviewed) { %>
    <div class="mb-12 bg-white/5 rounded-2xl p-6 border border-white/20 backdrop-blur-md">
        <h3 class="text-xs  text-white/80! mb-6 uppercase">Post a Review</h3>
        <form action="/listings/<%= listing._id %>/reviews" method="POST">
            <div class="mb-8">
                <label class="block text-[12px] font-black text-white/40 mb-3 uppercase tracking-widest">Rating</label>
                <div class="flex gap-4" id="star-group">
                    <% [1,2,3,4,5].forEach(star => { %>
                        <label class="cursor-pointer group">
                            <input type="radio" name="rating" value="<%= star %>" class="sr-only" required>
                            <span class="text-4xl text-white/10 group-hover:text-amber-400 star-label transition-colors" data-val="<%= star %>">★</span>
                        </label>
                    <% }) %>
                </div>
            </div>
            <div class="mb-8">
                <label class="block text-[12px] font-black text-white/40 mb-3 uppercase tracking-widest">Your Experience</label>
                <textarea name="comment" rows="3" maxlength="500" required placeholder="Describe the feeling..."
                    class="w-full rounded-xl border border-white/20 bg-white/5 px-4 py-2 text-sm text-white placeholder:text-white/20 focus:border-white/40 focus:bg-white/10 focus:outline-none transition-all resize-none shadow-inner"></textarea>
            </div>
            <button type="submit" class="rounded-full! bg-white px-10 py-3 text-[12px] font-black text-indigo-950 uppercase tracking-widest transition shadow-xl hover:brightness-70">
                Submit Review
            </button>
        </form>
    </div>
    <% } else if (currentUser && hasRented && hasReviewed) { %>
    <div class="mb-10 bg-white/10 border border-white/20 rounded-xl px-6 py-4 text-xs text-white/80 font-black uppercase tracking-widest text-center backdrop-blur">
        ✓ Review recorded. Thank you for your feedback.
    </div>
    <% } else if (currentUser && !hasRented) { %>
    <div class="mb-10 bg-white/5 border border-white/10 rounded-xl px-6 py-4 text-xs text-white/60 font-bold uppercase tracking-widest text-center">
        Only users who have rented this listing can post a review.
    </div>
    <% } %>

    <!-- EXISTING REVIEWS -->
    <% if (reviews.length === 0) { %>
        <div class="text-center py-5 text-white/80">
            <i class="fa-regular fa-comment-dots text-5xl mb-6 block"></i>
            <p class="text-xs font-black uppercase tracking-[0.3em]">No review yet</p>
        </div>
    <% } else { %>
        <div class="space-y-6">
            <% reviews.forEach(review => { %>
                <div class="group border border-white/10 rounded-2xl p-6 bg-white/5 backdrop-blur-md transition-all hover:bg-white/10 hover:shadow-2xl">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full border border-white/20 bg-linear-to-br from-white/10 to-indigo-500/30 text-white flex items-center justify-center text-lg font-black shadow-lg">
                                <%= review.user.username.charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <p class="text-sm font-black text-white uppercase tracking-widest"><%= review.user.username %></p>
                                <p class="text-amber-400 text-sm leading-none mt-1">
                                    <% for(let i=1; i<=5; i++) { %><%= i <= review.rating ? '★' : '☆' %><% } %>
                                    <span class="text-white/40 text-[10px] font-bold ml-2 uppercase"><%= review.rating %> / 5.0</span>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 shrink-0">
                            <span class="text-[10px] font-black text-white/30 uppercase tracking-widest">
                                <%= review.createdAt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                            </span>
                            <% if (currentUser && (currentUser.toString() === review.user._id.toString() || currentUserRole === 'admin')) { %>
                                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST"
                                      onsubmit="return confirm('Delete this appraisal?')">
                                    <button class="text-white/20 hover:text-red-400 transition-colors">
                                        <i class="fa-solid fa-trash-can text-sm"></i>
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                    <p class="mt-5 text-sm text-white/80 leading-relaxed font-medium"><%= review.comment %></p>
                </div>
            <% }) %>
        </div>
    <% } %>

</div>

<script>
    const labels = document.querySelectorAll('.star-label');
    const starGroup = document.getElementById('star-group');
    labels.forEach((star, idx) => {
        star.addEventListener('click', () => {
            labels.forEach((s, i) => { s.style.color = i <= idx ? '#f59e0b' : ''; });
        });
        star.addEventListener('mouseover', () => {
            labels.forEach((s, i) => { s.style.color = i <= idx ? '#f59e0b' : '#cbd5e1'; });
        });
    });
    if (starGroup) {
        starGroup.addEventListener('mouseleave', () => {
            const checked = document.querySelector('input[name="rating"]:checked');
            const val = checked ? parseInt(checked.value) : 0;
            labels.forEach((s, i) => { s.style.color = i < val ? '#f59e0b' : ''; });
        });
    }
</script>