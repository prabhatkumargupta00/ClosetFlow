<% layout("/layouts/boilerplate.ejs") -%>

    <!-- CARD -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg">

      <!-- IMAGE BLOCK -->
      <div class="mb-8 flex justify-center">
        <div class="relative w-full max-w-md aspect-4/5 overflow-hidden rounded-2xl">
          <img src="<%= listing.image %>" alt="Listing Image" class="h-full w-full object-cover object-top" />

          <span
            class="absolute left-4 top-4 rounded-full bg-black/80 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-white backdrop-blur">
            <%= listing.rentalStatus %>
          </span>
        </div>
      </div>

      <!-- DETAILS -->
      <div class=" mx-3 md:mx-6">

        <h1 class="text-2xl sm:text-3xl font-semibold leading-tight text-slate-900">
          <%= listing.title %>
        </h1>

        <p class="text-base leading-relaxed text-slate-700">
          <%= listing.description %>
        </p>

        <!-- META -->
        <div class="flex flex-wrap gap-y-6 gap-x-12">

          <div class="w-[45%]">
            <p class="text-xs uppercase tracking-widest text-slate-500">Category</p>
            <p class="mt-1 font-medium text-slate-900">
              <%= listing.category %>
            </p>
          </div>

          <div class="w-[45%]">
            <p class="text-xs uppercase tracking-widest text-slate-500">Occasion</p>
            <p class="mt-1 font-medium text-slate-900">
              <%= listing.occasion %>
            </p>
          </div>

          <div class="w-[45%]">
            <p class="text-xs uppercase tracking-widest text-slate-500">Fit</p>
            <p class="mt-1 font-medium text-slate-900">
              <%= listing.fitType %>
            </p>
          </div>

          <div class="w-[45%]">
            <p class="text-xs uppercase tracking-widest text-slate-500">Sizes</p>
            <p class="mt-1 font-medium text-slate-900">
              <%= listing.size.join(", ") %></p>
        </div>

        <div class=" w-[45%]">
                <p class="text-xs uppercase tracking-widest text-slate-500">Location</p>
                <p class="mt-1 font-medium text-slate-900">
                  <%= listing.location %>
                </p>
          </div>

          <% if (listing.brand) { %>
            <div class="w-[45%]">
              <p class="text-xs uppercase tracking-widest text-slate-500">Brand</p>
              <p class="mt-1 font-medium text-slate-900">
                <%= listing.brand %>
              </p>
            </div>
            <% } %>

              <% if (listing.color) { %>
                <div class="w-[45%]">
                  <p class="text-xs uppercase tracking-widest text-slate-500">Color</p>
                  <p class="mt-1 font-medium text-slate-900">
                    <%= listing.color %>
                  </p>
                </div>
                <% } %>

        </div>

        <!-- PRICE + RATING -->
        <div class="flex items-center justify-between border-t border-slate-200 pt-6">

          <div>
            <p class="text-xs uppercase tracking-widest text-slate-500">Rental Price</p>
            <p class="mt-1 text-xl font-semibold text-emerald-600">
              ₹ <%= listing.pricePerDay.toLocaleString("en-IN") %>
                <span class="text-sm text-slate-500">/ day</span>
            </p>
          </div>

          <div class="text-right">
            <p class="text-xs uppercase tracking-widest text-slate-500">Rating</p>
            <p class="mt-1 font-medium text-amber-500">
              ⭐ <%= listing.rating %> / 5
            </p>
          </div>

        </div>

        <!-- CTA -->
        <% if (currentUser) { %>
          <a href="/rentals/<%= listing._id %>"
            class="block w-full rounded-2xl! bg-linear-to-br from-emerald-500 to-emerald-800 px-4 py-3 text-base font-semibold text-white shadow-lg transition hover:from-emerald-700 hover:to-emerald-800 text-center no-underline">
            Rent this outfit
          </a>
          <% } else { %>
            <a href="/login"
              class="block w-full rounded-2xl! border border-slate-300 bg-slate-800! px-4 py-3 text-center text-base font-semibold text-white shadow-sm transition hover:bg-slate-900">
              Login to rent this outfit
            </a>
          <% } %>

            <% if (currentUser && (currentUserRole==="admin" || currentUser.toString() === listing.owner.toString())) { %>
      <div class="mt-4 flex items-center gap-4">
        <!-- Edit --> <a
          href="/listings/<%= listing._id %>/edit"
          class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-6 py-2.5 text-sm font-medium text-white shadow transition hover:bg-slate-800">
          Edit Listing </a> <!-- Delete -->
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post"
          onsubmit="return confirm('This action cannot be undone. Delete this listing?')"> <button
            class="inline-flex items-center justify-center rounded-lg! bg-red-600 px-6 py-2.5 text-sm font-medium text-white shadow transition overflow-hidden hover:bg-red-700">
            Delete Listing </button> </form>
      </div>
      <% } %>
      </div>

    </div>

<!-- REVIEWS SECTION -->
<div class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-lg">

    <div class="flex items-center mb-6">
        <h2 class="text-xl font-semibold text-slate-900">
            Reviews
            <% if (reviews.length > 0) { %>
                <span class="ml-2 text-sm font-normal text-amber-500">⭐ <%= listing.rating %> / 5</span>
                <span class="text-sm text-slate-400 font-normal">(<%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %>)</span>
            <% } %>
        </h2>
    </div>

    <!-- REVIEW FORM: only if logged in, has completed rental, hasn't reviewed yet -->
    <% if (currentUser && hasRented && !hasReviewed) { %>
    <div class="mb-8 bg-slate-50 rounded-2xl p-5 border border-slate-200">
        <h3 class="text-sm font-semibold text-slate-700 mb-4 uppercase tracking-wider">Leave a Review</h3>
        <form action="/listings/<%= listing._id %>/reviews" method="POST">
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-600 mb-2">Rating</label>
                <div class="flex gap-2" id="star-group">
                    <% [1,2,3,4,5].forEach(star => { %>
                        <label class="cursor-pointer">
                            <input type="radio" name="rating" value="<%= star %>" class="sr-only" required>
                            <span class="text-3xl text-slate-300 star-label" data-val="<%= star %>">★</span>
                        </label>
                    <% }) %>
                </div>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-600 mb-2">Your Review</label>
                <textarea name="comment" rows="3" maxlength="500" required placeholder="Share your experience with this outfit..."
                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-900 focus:outline-none resize-none"></textarea>
            </div>
            <button type="submit" class="rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800">
                Submit Review
            </button>
        </form>
    </div>
    <% } else if (currentUser && hasRented && hasReviewed) { %>
    <div class="mb-6 bg-emerald-50 border border-emerald-200 rounded-xl px-5 py-3 text-sm text-emerald-700 font-medium">
        ✓ You've already reviewed this outfit. Thank you!
    </div>
    <% } else if (currentUser && !hasRented) { %>
    <div class="mb-6 bg-slate-50 border border-slate-200 rounded-xl px-5 py-3 text-sm text-slate-500">
        Only users who have rented and returned this outfit can leave a review.
    </div>
    <% } %>

    <!-- EXISTING REVIEWS -->
    <% if (reviews.length === 0) { %>
        <div class="text-center py-10 text-slate-400">
            <i class="fa-regular fa-comment-dots text-3xl mb-3 block"></i>
            <p class="text-sm">No reviews yet. Be the first to review after renting!</p>
        </div>
    <% } else { %>
        <div class="space-y-4">
            <% reviews.forEach(review => { %>
                <div class="border border-slate-100 rounded-2xl p-5 bg-white">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-sm font-bold shrink-0">
                                <%= review.user.username.charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-slate-900"><%= review.user.username %></p>
                                <p class="text-amber-400 text-sm leading-none mt-0.5">
                                    <% for(let i=1; i<=5; i++) { %><%= i <= review.rating ? '★' : '☆' %><% } %>
                                    <span class="text-slate-400 text-xs ml-1"><%= review.rating %>/5</span>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 shrink-0">
                            <span class="text-xs text-slate-400">
                                <%= review.createdAt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            </span>
                            <% if (currentUser && (currentUser.toString() === review.user._id.toString() || currentUserRole === 'admin')) { %>
                                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST"
                                      onsubmit="return confirm('Delete this review?')">
                                    <button class="text-red-400 hover:text-red-600 text-xs transition">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                    <p class="mt-3 text-sm text-slate-600 leading-relaxed"><%= review.comment %></p>
                </div>
            <% }) %>
        </div>
    <% } %>

</div>

<script>
    const labels = document.querySelectorAll('.star-label');
    const starGroup = document.getElementById('star-group');
    labels.forEach((star, idx) => {
        star.addEventListener('click', () => {
            labels.forEach((s, i) => { s.style.color = i <= idx ? '#f59e0b' : ''; });
        });
        star.addEventListener('mouseover', () => {
            labels.forEach((s, i) => { s.style.color = i <= idx ? '#f59e0b' : '#cbd5e1'; });
        });
    });
    if (starGroup) {
        starGroup.addEventListener('mouseleave', () => {
            const checked = document.querySelector('input[name="rating"]:checked');
            const val = checked ? parseInt(checked.value) : 0;
            labels.forEach((s, i) => { s.style.color = i < val ? '#f59e0b' : ''; });
        });
    }
</script>