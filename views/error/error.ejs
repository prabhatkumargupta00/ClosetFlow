<% layout("/layouts/boilerplate.ejs") -%>

    <div class="flex min-h-[75vh] items-center justify-center px-4 relative overflow-hidden">
        <div class="w-full max-w-2xl relative z-10">
            <!-- CARD -->
            <div class="bg-indigo-500/10 backdrop-blur-md border border-white/20 rounded-4xl overflow-hidden shadow-2xl">
                
                <!-- HEADER -->
                <div class="px-8 pt-12 pb-8 text-center">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-400/20 border border-red-400/30 rounded-full mb-6">
                        <i class="fa-solid fa-circle-exclamation text-red-400 text-xs"></i>
                        <span class="text-[10px] font-black uppercase tracking-widest text-red-400">System Error</span>
                    </div>

                    <h1 class="text-3xl font-black text-white m-0 tracking-tight uppercase">
                        Something went wrong
                    </h1>

                    <p class="mx-auto mt-4 max-w-md text-sm font-medium text-white/60 leading-relaxed">
                        Something went wrong on our side. Please try again or go back to home.
                    </p>
                </div>

                <!-- ERROR MESSAGE -->
                <div class="mx-8 bg-white/5 border border-white/10 rounded-2xl p-6 mb-8 shadow-inner">
                    <p class="text-[10px] font-black uppercase tracking-widest text-white/30 mb-2">Message</p>
                    <p class="text-sm font-bold text-white leading-relaxed wrap-break-word m-0">
                        <%= err.message %>
                    </p>
                </div>

                <!-- TECH DETAILS (DEV ONLY) -->
                <% if (process.env.NODE_ENV !== "production") { %>
                    <div class="mx-8 mb-8">
                        <details class="group">
                            <summary class="cursor-pointer text-[10px] font-black uppercase tracking-widest text-indigo-400 hover:text-indigo-300 transition-colors list-none flex items-center gap-2">
                                <i class="fa-solid fa-code text-xs"></i>
                                Technical Stack Trace
                                <i class="fa-solid fa-chevron-down text-[8px] group-open:rotate-180 transition-transform"></i>
                            </summary>

                            <div class="mt-4 rounded-xl bg-black/40 border border-white/5 p-5 shadow-2xl overflow-x-auto">
                                <pre class="text-[11px] font-mono leading-relaxed text-indigo-100/70 whitespace-pre-wrap"><%= err.stack %></pre>
                            </div>
                        </details>
                    </div>
                <% } %>

                <!-- FOOTER ACTION -->
                <!-- <div class="p-8 bg-white/5 border-t border-white/5">
                    <a href="/" class="block w-full py-4 bg-linear-to-r from-indigo-600 to-indigo-500 text-white text-xs font-black uppercase tracking-widest rounded-4xl text-center no-underline transition shadow-lg shadow-black/20 hover:scale-[1.02] hover:shadow-indigo-500/40 active:scale-95">
                        Go back to home
                    </a>
                </div> -->
            </div>
        </div>
    </div>
