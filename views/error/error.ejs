<% layout("/layouts/boilerplate.ejs") -%>

    <div class="flex min-h-[75vh] items-center justify-center bg-slate-50 px-4">
        <div class="w-full max-w-3xl">

            <!-- CARD -->
            <div
                class="overflow-hidden rounded-[26px] border border-slate-200 bg-white shadow-2xl">

                <!-- HEADER -->
                <div class="px-12 pt-8 text-center">
                    <p class="text-md uppercase tracking-[0.25em] text-slate-700">
                        Error
                    </p>

                    <h1 class="mt-2 text-[2.6rem] font-semibold tracking-tight text-slate-900">
                        Something went wrong
                    </h1>

                    <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-slate-600">
                        The request could not be completed. <br>
                        Please try again or return to the homepage.
                    </p>
                </div>

                <!-- ERROR MESSAGE -->
                <div class="mx-12 mt-10 rounded-2xl border border-slate-200 bg-slate-50 px-8 py-6">
                    <p class="text-xs uppercase tracking-widest text-slate-500">
                        Details
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-slate-800 wrap-break-words">
                        <%= err.message %>
                    </p>
                </div>

                <!-- TECH DETAILS (DEV ONLY) -->
                <% if (process.env.NODE_ENV !=="production" ) { %>
                    <details class="mx-12 mt-8">
                        <summary class="cursor-pointer text-sm font-medium text-slate-700">
                            Technical information
                        </summary>

                        <pre
                            class="mt-4 max-h-64 overflow-auto rounded-2xl bg-slate-900 p-6 text-xs leading-relaxed text-slate-100">
                            <%= err.stack %>
                        </pre>
                    </details>
                <% } %>

                        <!-- FOOTER ACTION -->
                        <div class="mt-12 border-t border-slate-200 bg-slate-50 px-12 py-6">
                            <a href="/"
                                class="block w-full rounded-xl bg-slate-900 py-3.5 text-center text-base font-medium text-white transition hover:bg-slate-800">
                                Go back to home
                            </a>
                        </div>

            </div>

        </div>
    </div>