<% layout("/layouts/boilerplate.ejs") -%>

<div class="max-h-screen  flex items-center justify-center py-20 px-4">
    <div class="max-w-md w-full bg-white rounded-3xl shadow-2xl p-10 text-center border border-gray-100">
        
        <div class="text-8xl font-black tracking-tight text-gray-200 mb-2 select-none">
            403
        </div>

        <h1 class="text-2xl font-semibold text-gray-900 mb-3">
            Restricted Access
        </h1>

        <p class="text-gray-600 mb-10 leading-relaxed">
            This resource is protected and requires elevated privileges.
            Please verify your access level or return to a permitted area.
        </p>

        <div class="flex justify-center gap-4">
            <a
                href="/"
                class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-slate-700 shadow-md hover:bg-indigo-700 hover:shadow-lg transition-all duration-200"
            >
                Return to home 
            </a>

            <button
                onclick="history.back()"
                class="inline-flex items-center justify-center rounded-xl! border border-gray-300 px-6 py-3 text-sm font-medium text-slate-700 shadow-md hover:bg-gray-100 hover:shadow-lg  transition-all duration-200"
            >
                Login as admin
            </button>
        </div>

        <!-- <div class="mt-10 text-xs text-gray-400">
            Error Code 403 · Authorization Required
        </div> -->
    </div>
</div>
