<% layout("/layouts/boilerplate.ejs") -%>

<div class="min-h-[75vh] flex items-center justify-center py-20 px-4 relative overflow-hidden">
    <!-- Background Glows -->
    
    <div class="max-w-md w-full relative z-10">
        <div class="bg-indigo-500/10 backdrop-blur-md border border-white/20 rounded-4xl p-10 text-center shadow-2xl relative overflow-hidden">
            <!-- Decorative Icon -->
            <div class="w-20 h-20 bg-linear-to-br from-indigo-500/20 to-red-400/20 rounded-2xl mx-auto mb-8 flex items-center justify-center border border-white/10 shadow-inner">
                <i class="fa-solid fa-shield-halved text-white/40 text-3xl"></i>
            </div>
            
            <div class="text-7xl font-black tracking-tighter text-white mb-4 select-none drop-shadow-2xl">
                403
            </div>

            <h1 class="text-2xl font-black text-white uppercase tracking-wider mb-4">
                Restricted Access
            </h1>

            <p class="text-white/60 mb-10 text-sm font-medium leading-relaxed">
                You don't have permission to see this page. 
                Please log in as an admin or go back to home.
            </p>

            <div class="flex flex-col gap-3">
                <a href="/" class="w-full py-4 bg-linear-to-r from-indigo-600 to-indigo-500 text-white text-xs font-black uppercase tracking-widest rounded-2xl transition shadow-lg shadow-black/20 hover:scale-[1.02] hover:shadow-indigo-500/40 active:scale-95 no-underline">
                    Return to home 
                </a>

                <button onclick="history.back()" class="w-full py-4 bg-white/5 border border-white/10 text-white text-xs font-black uppercase tracking-widest rounded-2xl transition hover:bg-white/10 active:scale-95">
                    Login as admin
                </button>
            </div>
        </div>
    </div>
</div>
