<nav class="sticky top-0 z-50 bg-slate-900/95 text-white shadow-sm backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-3">

        <!-- Brand -->
        <a href="/" class="flex items-center gap-2 text-xl md:text-2xl font-semibold no-underline text-white">
            <i class="fa-solid fa-house"></i>
            <span class="hidden md:inline">ClosetFlow</span>
        </a>

        <!-- Left links -->
        <div class="ml-4 hidden items-center gap-3 md:flex">
            <% if (currentUserRole =="admin" ) { %>
                <a href="/listings/new"
                    class="rounded-md px-3 py-2 text-sm font-medium border border-white/20 text-white no-underline hover:bg-white/10">
                    Add Listing
                </a>
                <% } %>
        </div>

        <!-- Search -->
        <form class="ml-auto flex items-center gap-2" action="/listings" method="GET">
            <input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Search outfits"
                class="w-56 rounded-md border border-white/15 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-white/60 outline-none focus:border-white/30 focus:bg-white/15" />
            <button type="submit"
                class="rounded-md! border border-white/20 px-3 py-2 text-sm font-medium hover:bg-white/10">
                Search
            </button>
        </form>

        <!-- Auth / Dropdown -->
        <div class="ml-4 hidden items-center md:flex">
            <% if (!currentUser) { %>
                <a href="/login"
                    class="rounded-md! border border-white/20 px-3 py-2 text-sm font-medium no-underline hover:bg-white/10">
                    Login
                </a>
                <a href="/register"
                    class="ml-2 rounded-md! bg-white px-3 py-2 text-sm font-semibold text-slate-900 no-underline hover:bg-white/90">
                    Register
                </a>
                <% } else { %>
                    <!-- Dropdown -->
                    <div class="relative">
                        <button onclick="document.getElementById('userMenu').classList.toggle('hidden')"
                            class="flex items-center gap-2 rounded-md! border border-white/20 px-3 py-2 text-sm font-medium hover:bg-white/10">
                            <i class="fa-solid fa-user"></i>
                            <span>
                                <%= currentUsername || "Account" %>
                            </span>
                        </button>

                        <div id="userMenu"
                            class="absolute h-fit mt-4 w-52 hidden rounded-md! border bg-slate-900 shadow-lg">
                            <% if (currentUserRole==="user" ) { %>
                                <a href="/my-Rentals"
                                    class="block px-5 py-2 text-nowrap text-md border-b border-slate-800/50 hover:bg-white/10 no-underline text-white">
                                    My Rentals
                                </a>
                                
                                <!-- <a href="/dashboard"
                                    class="block px-5 py-2 text-md border-b border-slate-800/50 hover:bg-white/10 no-underline text-white">
                                    Dashboard
                                </a> -->
                                <% } %>

                                    <% if (currentUserRole ==="admin" ) { %>
                                        <a href="/admin/dashboard"
                                            class="block px-5 py-2 text-md border-b border-slate-800/50 hover:bg-white/10 no-underline text-white">
                                            Admin Dashboard
                                        </a>
                                        <a href="/admin/listings"
                                            class="block px-5 py-2 text-md border-b border-slate-800/50 hover:bg-white/10 no-underline text-white">
                                            Manage Listings
                                        </a>
                                        <a href="/admin/rentals"
                                            class="block px-5 py-2 text-md border-b border-slate-800/50 hover:bg-white/10 no-underline text-white">
                                            All Rentals
                                        </a>
                                        <% } %>

                                            <form action="/logout" method="POST">
                                                <button type="submit"
                                                    class="w-full text-left px-5 py-2 text-md text-red-400 hover:bg-white/10">
                                                    Logout
                                                </button>
                                            </form>
                        </div>
                    </div>
                    <% } %>
        </div>

        <!-- Mobile toggle -->
        <button type="button"
            class="ml-2 inline-flex items-center justify-center rounded-md! p-2 text-white hover:bg-white/10 md:hidden"
            onclick="document.getElementById('mobileNav').classList.toggle('hidden')">
            
        </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobileNav" class="hidden border-t border-white/10 bg-slate-900 md:hidden">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-3">

            <% if (currentUserRole==="admin" ) { %>
                <a href="/listings/new" class="px-3 py-2 text-sm hover:bg-white/10 no-underline text-white">
                    Add Listing
                </a>
                <% } %>

                    <% if (currentUser) { %>
                        <a href="/dashboard" class="px-3 py-2 text-sm hover:bg-white/10 no-underline text-white">
                            Dashboard
                        </a>

                        <form action="/logout" method="POST">
                            <button type="submit"
                                class="w-full text-left px-3 py-2 text-sm text-red-400 hover:bg-white/10">
                                Logout
                            </button>
                        </form>
                        <% } else { %>
                            <a href="/login" class="px-3 py-2 text-sm bg-white text-slate-900 font-semibold rounded-md! no-underline">
                                Login
                            </a>
                            <a href="/register"
                                class="px-3 py-2 text-sm bg-white text-slate-900 font-semibold rounded-md! no-underline">
                                Register
                            </a>
                            <% } %>
        </div>
    </div>
</nav>