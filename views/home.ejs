<% layout("/layouts/boilerplate.ejs") -%>

<!-- HERO SECTION -->
<section class="relative overflow-hidden mb-2 border-b rounded-2xl shadow-lg shadow-indigo-500/10 border-indigo-100 bg-linear-to-br! from-indigo-300/60 to-red-300/60 py-20">
  <div class="mx-auto max-w-7xl px-4">
    <div class="flex flex-col items-center gap-14 md:flex-row md:items-center">

      <!-- CONTENT -->
      <div class="max-w-xl ">

        <span class="inline-flex items-center mb-2 rounded-full bg-indigo-100 px-5 py-2 text-xs font-semibold uppercase tracking-widest text-indigo-700">
          Premium Rental Wardrobe
        </span>

        <h1 class="mt-6 mb-12 text-3xl sm:text-4xl md:text-5xl font-semibold leading-tight tracking-tight text-slate-900">
          Rent the outfit.<br />
          Own the moment.
        </h1>

        <p class="mt-8 w-[80%] text-lg font-medium leading-relaxed text-slate-700">
          Curated ethnic and formal wear for weddings, festivities,
          and unforgettable moments — without the commitment of ownership.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/listings"
            class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-8 py-4 text-sm font-semibold text-white shadow-lg transition hover:bg-indigo-700"
          >
            Browse Collection
          </a>

          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-8 py-4 text-sm font-semibold text-slate-800 shadow-sm transition hover:bg-slate-100"
          >
            How it works
          </a>
        </div>
      </div>

      <!-- IMAGE -->
      <div class="relative flex w-full max-w-md justify-center">
        <div class="absolute inset-0 -z-10 rounded-3xl bg-slate-200 blur-3xl opacity-40"></div>

        <img
          src="/assets/closet flow.png"
          alt="Premium outfits"
          class="w-full rounded-3xl object-contain shadow-2xl"
        />
      </div>

    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="how-it-works" class="border-t mb-2 rounded-2xl shadow-md border-slate-200 bg-linear-to-br! from-indigo-300/60 to-red-300/60 py-10">
  <div class="mx-auto max-w-7xl px-4 text-center">

    <!-- SECTION HEADER -->
    <h2 class="text-3xl font-semibold tracking-tight text-slate-900">
      How ClosetFlow Works
    </h2>
    <p class="mx-auto  max-w-2xl text-base text-slate-600">
      A seamless rental experience designed for modern occasions.
    </p>

    <!-- STEPS -->
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

      <!-- STEP 1 -->
       <a href="/listings">
      <div class="group rounded-2xl bg-gray-700 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
        <div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">
          01
        </div>
        <h5 class="text-md font-semibold text-white">
          Browse
        </h5>
        <p class="mt-2 text-sm leading-relaxed text-white/50">
          Explore premium outfits curated for weddings, festivities, and formal events.
        </p>
      </div></a>

      <!-- STEP 2 -->
      <div class="group rounded-2xl bg-gray-700 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
        <div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">
          02
        </div>
        <h5 class="text-md font-semibold text-white">
          Rent
        </h5>
        <p class="mt-2 text-sm leading-relaxed text-white/50">
          Select your dates, confirm availability, and reserve in minutes.
        </p>
      </div>

      <!-- STEP 3 -->
      <div class="group rounded-2xl bg-gray-700 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
        <div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">
          03
        </div>
        <h5 class="text-md font-semibold text-white">
          Return
        </h5>
        <p class="mt-2 text-sm leading-relaxed text-white/50">
          Wear it confidently, then return it effortlessly. No ownership worries.
        </p>
      </div>

    </div>

  </div>
</section>
